# cli = Longbridge CLI (needs `longbridge auth login`), demo = synthetic data for trying the UI
DATA_MODE=cli
CACHE_TTL_SECONDS=900
# per-ticker cache files in the data folder: a repeat search within this many minutes reuses them (0 = off)
DISK_CACHE_MINUTES=30
# optional, enables the written bull/bear narrative (Google Gemini)
GEMINI_API_KEY=
# optional: override the Gemini model
# GEMINI_MODEL=gemini-2.5-flash
