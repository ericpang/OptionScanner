# cli = Longbridge CLI (needs `longbridge auth login`), demo = synthetic data for trying the UI
DATA_MODE=cli
# per-ticker cache files in the data folder: how many minutes a ticker's file, and the fundamentals in it (statements,
# ratings, holders), are reused. 10080 (or 60*24*7) is a week. 0 = off, so every search fetches live data
DISK_CACHE_MINUTES=10
# optional: how many minutes the market data in that file (prices, bars, options, news) is reused before it is fetched
# again. Never more than DISK_CACHE_MINUTES. 0 = fetched on every search
# LIVE_CACHE_MINUTES=60
# optional, enables the written bull/bear narrative (Google Gemini)
GEMINI_API_KEY=
# optional: override the Gemini model
# GEMINI_MODEL=gemini-2.5-flash
# optional, lets the app read the latest 10-K and 10-Q from SEC EDGAR (US stocks). The SEC requires your name and email.
# SEC_USER_AGENT=Your Name your.email@example.com
# optional: how many trading days back the anchored VWAP starts (5 to 500, default 20). The chart also has a box to change it.
# AVWAP_DAYS=20
# optional: how many days a peer's computed figures are reused (data/peers.json). The peer comparison measures about ten
# companies, which takes 40 seconds the first time; 0 = never reused
# PEER_CACHE_DAYS=7
